{
  "name": "@theoplayer/vega-demo",
  "version": "0.0.0",
  "author": "Dolby Laboratories, Inc.",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "app:debug": "npm-run-all build:debug install:debug app:launch",
    "app:release": "npm-run-all build:release install:release app:launch",
    "app:launch": "vega device launch-app --directory .",
    "app:terminate": "vega device terminate-app --directory .",
    "app:uninstall": "vega device uninstall-app --directory .",
    "app:relaunch": "npm run app:terminate; npm run app:launch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typescript": "tsc --noEmit",
    "test": "node --test \"test/*.test.cjs\"",
    "build:debug": "react-native build-kepler --build-type Debug",
    "install:debug": "vega device install-app --directory . --buildType Debug",
    "build:release": "react-native build-kepler --build-type Release",
    "install:release": "vega device install-app --directory . --buildType Release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint typescript test build:release"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@amazon-devices/kepler-media-controls": "^1.0.25",
    "@amazon-devices/react-native-gesture-handler": "4.0.0",
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/react-native-safe-area-context": "8.0.9000000000",
    "@amazon-devices/react-native-screens": "3.0.9000000000",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@amazon-devices/react-navigation__core": "8.0.9000000000",
    "@amazon-devices/react-navigation__native": "8.0.9000000000",
    "@amazon-devices/react-navigation__stack": "8.0.9000000000",
    "@amazon-devices/webview": "4.0.4-rn-83",
    "@logituit-rel/logix-ads-manager": "file:lib/logituit-rel-logix-ads-manager-0.3.0+theoplayer.3.tgz",
    "@theoplayer/react-native-drm": "1.13.0",
    "@theoplayer/react-native-ui": "0.23.5",
    "@theoplayer/react-native-vega": "file:lib/theoplayer-react-native-vega-1.0.0-beta.21.tgz",
    "@theoplayer/react-native-xagget": "https://cdn.theoplayer.com/react-native-theoplayer/theoplayer-react-native-xagget-1.7.0.tgz",
    "@theoplayer/theomux-vega": "file:lib/theoplayer-theomux-vega-1.0.0.tgz",
    "@theoplayer/vega": "file:lib/theoplayer-vega-1.0.0-beta.21.tgz",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-device-info": "npm:@amazon-devices/react-native-device-info@^2.1.9000000000",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg": "npm:@amazon-devices/react-native-svg@~3.0.0",
    "react-native-theoplayer": "10.13.0",
    "theoplayer": "^11.11.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@eslint/js": "^9.35.0",
    "@react-native-community/cli": "11.3.2",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^7.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.6.3",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "overrides": {
    "react-native-svg": "$react-native-svg",
    "react-native-theoplayer": "$react-native-theoplayer",
    "@amazon-devices/react-native-kepler": "$@amazon-devices/react-native-kepler",
    "@amazon-devices/webview": "$@amazon-devices/webview",
    "theoplayer": "$theoplayer"
  },
  "kepler": {
    "projectType": "application",
    "appName": "OptiViewVegaDemo",
    "targets": [
      "tv"
    ]
  }
}
